{
  "name": "dsh-media-log",
  "version": "1.0.0",
  "description": "DeepSeek Harness plugin that logs what you watch and play: mark media, search, and read details from a local SQLite library the plugin owns.",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "dsh": "0.2.2-rc.1",
    "node": ">=24 <25"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test --test-timeout=10000 \"test/*.test.js\"",
    "prepack": "node scripts/build.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "private": false
}
